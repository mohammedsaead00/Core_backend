      CREATE TRIGGER dbo.trg_profiles_updated_at
      ON dbo.profiles
      AFTER UPDATE
      AS
      BEGIN
          SET NOCOUNT ON;
          UPDATE p SET updated_at = SYSDATETIMEOFFSET()
          FROM dbo.profiles p INNER JOIN inserted i ON i.id = p.id;
      END
