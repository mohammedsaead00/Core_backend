      CREATE TRIGGER dbo.trg_daily_summary_updated_at
      ON dbo.daily_summary
      AFTER UPDATE
      AS
      BEGIN
          SET NOCOUNT ON;
          UPDATE s SET updated_at = SYSDATETIMEOFFSET()
          FROM dbo.daily_summary s INNER JOIN inserted i ON i.id = s.id;
      END
